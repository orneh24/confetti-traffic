#!/sbin/openrc-run
# OpenRC service: auto-configure the hub's static IP from guestinfo on
# first boot.
#
# Mirrors node's confettid-firstboot: only acts when guestinfo actually
# carries both required keys. With neither present, this stands down rather
# than prompting -- an OpenRC start() has no reliable attached tty to read
# from, so it must never be the thing that blocks the boot. The interactive
# path lives in confettictl-hub-setup.sh instead, invited at first login by
# confettictl-login-setup.sh, where a real tty is guaranteed.
#
# After that, every boot re-reads guestinfo.hub.hostname (see
# _apply_hostname); the network keys are used only once.

name="confettid-hub-firstboot"
description="Configure hub static IP from VMware guestinfo on first boot"

depend() {
    need net
    after open-vm-tools
    before confettid-hub
}

command_background="no"

CONF_DIR="/etc/confetti-hub"
STAMP="${CONF_DIR}/.setup-done"

_guestinfo() {
    if command -v vmware-rpctool >/dev/null 2>&1; then
        vmware-rpctool "info-get guestinfo.$1" 2>/dev/null | tr -d '\r\n'
    elif command -v vmtoolsd >/dev/null 2>&1; then
        vmtoolsd --cmd "info-get guestinfo.$1" 2>/dev/null | tr -d '\r\n'
    fi
}

# Later boots: apply guestinfo.hub.hostname if it is set and differs from
# the current name, so a rename in vCenter takes effect at the next reboot
# (as it does for nodes). Only the hostname: the network keys stay one-shot,
# since a wrong IP applied at boot would cut the hub off. Same steps as
# confettictl-set-static-ip's hostname part.
_apply_hostname() {
    _hn=$(_guestinfo "hub.hostname")
    case "$_hn" in *"No value found"*) _hn="" ;; esac
    [ -n "$_hn" ] || return 0
    case "$_hn" in
        *[!A-Za-z0-9-]*|-*)
            ewarn "guestinfo.hub.hostname '$_hn' is not a valid hostname; ignored"
            return 0 ;;
    esac
    [ "$_hn" = "$(hostname)" ] && return 0

    ebegin "Renaming hub from guestinfo: $(hostname) -> $_hn"
    printf '%s\n' "$_hn" > /etc/hostname
    hostname "$_hn"
    if grep -q "127.0.1.1" /etc/hosts 2>/dev/null; then
        sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t${_hn}/" /etc/hosts
    else
        printf '127.0.1.1\t%s\n' "$_hn" >> /etc/hosts
    fi
    eend 0
}

start() {
    if [ -f "$STAMP" ]; then
        _apply_hostname
        return 0
    fi

    _ip=$(_guestinfo "hub.ip")
    _gw=$(_guestinfo "hub.gateway")

    # Optional, like confettictl-hub-setup.sh's prompts. Empty is passed through and
    # confettictl-set-static-ip skips it.
    _dns=$(_guestinfo "hub.dns")
    _hn=$(_guestinfo "hub.hostname")

    case "$_ip" in *"No value found"*) _ip="" ;; esac
    case "$_gw" in *"No value found"*) _gw="" ;; esac
    case "$_dns" in *"No value found"*) _dns="" ;; esac
    case "$_hn" in *"No value found"*) _hn="" ;; esac

    if [ -z "$_ip" ] || [ -z "$_gw" ]; then
        ewarn "guestinfo.hub.ip / guestinfo.hub.gateway not set"
        ewarn "skipping auto-setup -- log in and run: confettictl-hub-setup.sh"
        return 0
    fi

    ebegin "Configuring hub static IP from guestinfo"
    mkdir -p "$CONF_DIR"
    if confettictl-set-static-ip "$_ip" "$_gw" "$_dns" "$_hn" && rc-service networking restart; then
        date -u '+%Y-%m-%dT%H:%M:%SZ configured (guestinfo)' > "$STAMP"
        eend 0
    else
        eend 1 "static IP configuration failed"
    fi

    return 0
}

stop() {
    return 0
}
