# Python (a local venv for running the hub off-VM, per hub/requirements.txt)
__pycache__/
*.pyc
.venv/
venv/

# SQLite (hub.db and its WAL/SHM siblings) — runtime data, never checked in
*.db
*.db-journal
*.db-wal
*.db-shm

# Local env overrides (see dev/README.md "Running the hub by hand")
hub.env

# Generated at build time by hub/build-template.sh — not source
hub/agent/

# Local drift-checker marker (see .claude/settings.json Stop hook)
.claude/.drift-checked

# Claude Code per-user state. settings.json, agents/ and skills/ are shared
# and tracked; personal overrides and worktree checkouts are not.
.claude/settings.local.json
.claude/worktrees/

# Editor / OS clutter
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Ad-hoc session screenshots, not project deliverables
Claude outputs/

# dev/ toolkit's own runtime state — hub db/log/pid, simulated node configs
# and logs. The scripts and shims that generate this are tracked; what they
# write is not. See dev/README.md.
dev/run/
